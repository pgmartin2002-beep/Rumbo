# Motor de IA para extraer eventos desde URL (feature 003). Sin ANTHROPIC_API_KEY, importar por
# URL degrada a "fuente ilegible" de forma controlada (FR-012); la importación estructurada
# (JSON) sigue funcionando igual sin esta clave.
ANTHROPIC_API_KEY=

# Modelo usado para estructurar el evento a partir del HTML obtenido (research.md R3).
RUMBO_AI_MODEL=claude-haiku-4-5-20251001
# Tokens máximos de salida de la IA. Agendas grandes (muchas sesiones) necesitan margen para no
# truncar el JSON de la herramienta.
RUMBO_AI_MAX_TOKENS=16384

# Límites del contenido enviado al motor de IA (research.md R4, R8).
RUMBO_AI_MAX_HTML_BYTES=2097152
RUMBO_AI_MAX_CHARS=60000

# Render de agendas generadas con JavaScript (feature 004). Requiere ANTHROPIC_API_KEY igual que la
# vía ligera; sin clave, importar por URL degrada a "fuente ilegible" (FR-011/FR-012). Requiere
# Chromium instalado: `npx playwright install chromium`.
RUMBO_RENDER_ENABLED=true
# Presupuestos (ms). El total es el límite de la importación (FR-008); las fases reparten ese total.
RUMBO_RENDER_TOTAL_MS=120000
RUMBO_RENDER_LIGERA_MS=20000
RUMBO_RENDER_RENDER_MS=60000
RUMBO_RENDER_IA_MS=60000
