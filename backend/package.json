{
  "name": "rumbo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rumbo BFF - orquesta integraciones externas para el frontend PWA (feature 001)",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "tsx src/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "playwright": "^1.62.1",
    "undici": "^8.10.0",
    "win-ca": "^3.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
